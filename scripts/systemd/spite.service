[Unit]
Description=spiteware.ai morning run (/spite, unattended)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/code/alkait/spiteware.ai
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Documents/code/alkait/spiteware.ai/scripts/morning.sh
TimeoutStartSec=5h
